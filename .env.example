DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_DEFAULT_GUILD_ID=your_guild_id_here
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Comma-separated list of Discord User IDs allowed to interact with the AI agent
DISCORD_ALLOWED_USERS=1502871150676676749,123456789012345678

# AI backend for Agent Gateway mode: antigravity (default), gemini, claude, ollama, custom
DISCORD_AGENT_BACKEND=antigravity
# DISCORD_AGENT_BIN=/Users/krishnakanth/.local/bin/agy
# DISCORD_AGENT_MODEL=
# DISCORD_SYSTEM_PROMPT=
# DISCORD_SILENT_REJECT=false
